{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "lyric",
      "camelcase": "Lyric",
      "title": "Lyric",
      "scope": "source.lyric",
      "file-types": ["lyr"],
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm",
      "injections": "queries/injections.scm",
      "injection-regex": "^lyric$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Lyric grammar for tree-sitter",
    "authors": [{ "name": "Olivier" }],
    "links": { "repository": "https://github.com/lyriclang/tree-sitter-lyric" }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
